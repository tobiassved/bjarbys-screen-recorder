{
  "name": "bjarbys-skarminspelare-windows",
  "productName": "Bjarbys skärminspelare",
  "version": "0.1.0-prototyp",
  "description": "Windows-prototyp av Bjarbys skärminspelare (Electron). Spelar in data, polerar i efterhand.",
  "type": "module",
  "main": "main.js",
  "license": "MIT",
  "author": "Bjarbys skärminspelare",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "e2e": "node test/e2e.mjs",
    "smoke": "node test/smoke.mjs",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {},
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.65.0"
  },
  "build": {
    "appId": "com.brattoo.skarminspelare.windows",
    "productName": "Bjarbys skärminspelare",
    "files": ["main.js", "input.js", "preload.cjs", "lib/**", "renderer/**", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/uiohook-napi/**"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
